# Where the database and the chains' saved state live. On Railway this must be a mounted volume: SPAWN_DATA=/data
SPAWN_DATA=./data

# The Pons chain to read from (Robinhood Chain). A paid RPC makes the worker much steadier than the public one: set PONS_RPC on the host.
PONS_RPC=https://rpc.mainnet.chain.robinhood.com
# PONS_FACTORY=0x7eD598BcEf8bd9Edd8C97A195C6d13f40801EC7e
# PONS_ROUTER=0xe33E9E479dF8802cb0866d5d05258bEc4cF62948

# Capacity. Every chain is a running anvil process, so the number is capped, and so is how many one wallet may have.
SPAWN_MAX_CHAINS=100
SPAWN_MAX_PER_WALLET=5

# Rate limits count visitors by the address the nearest trusted proxy saw. SPAWN_TRUSTED_HOPS is how many proxies sit in front of the app:
# 1 for Railway alone, 2 with Cloudflare in front of Railway.
SPAWN_TRUSTED_HOPS=1
# SPAWN_CLIENT_IP_HEADER=x-forwarded-for

# Public address of the site (canonical links, sitemap, share card). Build time: it is baked into the pages, so set it before the build.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Base address for "View on Pons" links on trade pages, such as https://explorer.example (the page adds /tx/<hash>). Also build time.
NEXT_PUBLIC_PONS_EXPLORER=

# Port of the web app. The worker starts one anvil per chain on 9000 + n, on localhost only.
PORT=3000
